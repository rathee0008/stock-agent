# Copy to .env and fill in. .env is git-ignored.

# Optional — enables the Claude-written briefing. Without it the agent uses
# a deterministic rule-based summary.
ANTHROPIC_API_KEY=

# Optional — override the model used for synthesis.
STOCK_AGENT_MODEL=claude-sonnet-5

# Optional — secondary price source when Yahoo is rate-limited (free key at alphavantage.co)
ALPHAVANTAGE_API_KEY=

# Optional — alert / daily-brief delivery (also add as GitHub Actions secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
